{
  "name": "work-console-core",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node --experimental-strip-types --no-warnings=ExperimentalWarning server/main.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --env-file=test.env --test \"src/**/*.test.ts\" \"server/**/*.test.ts\" \"workspaces/**/*.test.ts\" \"scripts/*.test.ts\"",
    "smoke": "node --experimental-strip-types --no-warnings=ExperimentalWarning server/smoke.ts",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && vite build && node scripts/artifact.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.285",
    "marked": "^18.0.14",
    "node-forge": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
