{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bridge/work.get",
  "title": "work item detail",
  "type": "object",
  "properties": {
    "description": {
      "type": "string"
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "author",
          "at",
          "text"
        ],
        "additionalProperties": false
      },
      "maxItems": 20
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "from": {
            "type": "string"
          }
        },
        "required": [
          "ref",
          "name",
          "from"
        ],
        "additionalProperties": false
      },
      "maxItems": 20
    },
    "link": {
      "type": "string"
    },
    "area": {
      "type": "string"
    },
    "iteration": {
      "type": "string"
    },
    "prs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 50
    }
  },
  "required": [
    "description",
    "comments"
  ],
  "additionalProperties": false
}
