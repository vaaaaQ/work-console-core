{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bridge/tickets.item",
  "title": "ticket",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "assignedTo": {
      "type": [
        "string",
        "null"
      ]
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "link": {
      "type": "string",
      "format": "uri"
    }
  },
  "required": [
    "id",
    "title",
    "state",
    "assignedTo",
    "updatedAt",
    "link"
  ],
  "additionalProperties": false
}
