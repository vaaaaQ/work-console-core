{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bridge/board.item",
  "title": "board item",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "column": {
      "type": [
        "string",
        "null"
      ]
    },
    "lane": {
      "type": "string",
      "enum": [
        "free",
        "mine",
        "qa"
      ]
    },
    "assignedTo": {
      "type": [
        "string",
        "null"
      ]
    },
    "changedAt": {
      "type": "string",
      "format": "date-time"
    },
    "link": {
      "type": "string",
      "format": "uri"
    }
  },
  "required": [
    "id",
    "type",
    "title",
    "state",
    "column",
    "lane",
    "assignedTo",
    "changedAt",
    "link"
  ],
  "additionalProperties": false
}
