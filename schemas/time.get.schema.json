{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bridge/time.get",
  "title": "time entries",
  "type": "object",
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "hours": {
            "type": "number",
            "minimum": 0
          },
          "workItem": {
            "type": "string"
          },
          "activity": {
            "type": "string"
          },
          "comment": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "date",
          "hours",
          "workItem",
          "activity",
          "comment"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "entries"
  ],
  "additionalProperties": false
}
