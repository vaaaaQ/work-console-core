{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bridge/tickets.get",
  "title": "ticket detail",
  "type": "object",
  "properties": {
    "description": {
      "type": "string"
    },
    "workNotes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "author": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "author",
          "at",
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "description",
    "workNotes"
  ],
  "additionalProperties": false
}
