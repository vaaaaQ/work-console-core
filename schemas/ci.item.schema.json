{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bridge/ci.item",
  "title": "build",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "pipeline": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "result": {
      "type": [
        "string",
        "null"
      ]
    },
    "branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "startedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "finishedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "link": {
      "type": "string",
      "format": "uri"
    }
  },
  "required": [
    "id",
    "pipeline",
    "status",
    "result",
    "branch",
    "startedAt",
    "finishedAt",
    "link"
  ],
  "additionalProperties": false
}
